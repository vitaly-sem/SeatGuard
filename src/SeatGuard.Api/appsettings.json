{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "SeatGuard": "Host=localhost;Port=55432;Database=seatguard;Username=seatguard;Password=seatguard"
  },
  "Reservations": {
    "HoldDuration": "00:10:00",
    "AvailabilityCacheTtl": "00:00:02",
    "SweeperInterval": "00:00:15",
    "SweeperBatchSize": 100,
    "SweeperEnabled": true,
    "ConcurrencyStrategy": "Pessimistic"
  },
  "Outbox": {
    "PollInterval": "00:00:05",
    "BatchSize": 50,
    "MaxAttempts": 10,
    "LeaseDuration": "00:00:30",
    "Enabled": true
  },
  "Admin": {
    "ApiKey": ""
  },
  "RateLimiting": {
    "BookingsPerMinute": 120,
    "AdminPerMinute": 30
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Observability": {
    "ServiceName": "seatguard-api",
    "OtlpEndpoint": ""
  },
  "AllowedHosts": "*"
}

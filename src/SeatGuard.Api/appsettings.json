{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "SeatGuard": "Host=localhost;Port=55432;Database=seatguard;Username=seatguard;Password=seatguard;Gss Encryption Mode=Disable"
  },
  "Reservations": {
    "HoldDuration": "00:10:00",
    "AvailabilityCacheTtl": "00:00:10",
    "SweeperInterval": "00:00:15",
    "SweeperBatchSize": 100,
    "SweeperEnabled": true,
    "ConcurrencyStrategy": "Pessimistic"
  },
  "Outbox": {
    "PollInterval": "00:00:05",
    "BatchSize": 50,
    "MaxAttempts": 10,
    "LeaseDuration": "00:00:30",
    "Enabled": true,
    "CleanupEnabled": true,
    "RetentionDays": 7,
    "CleanupInterval": "01:00:00",
    "CleanupBatchSize": 1000
  },
  "Admin": {
    "ApiKey": ""
  },
  "RateLimiting": {
    "BookingsPerMinute": 120,
    "AdminPerMinute": 30,
    "ReadsPerMinute": 300
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Api": {
    "ExposeDocumentation": false
  },
  "Observability": {
    "Enabled": true,
    "ServiceName": "seatguard-api",
    "OtlpEndpoint": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
